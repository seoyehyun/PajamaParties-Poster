         set_input_kq_mask_impl<float>(args, (float *) dst->data, causal_attn);
     }
 
+    // KVSwap stage 1: during decoding keep only sink groups + M evenly spaced groups + the recent window,
+    // so the flash-attention kernel skips (and never faults in) every other cell
+    kvswap_sel.clear();
+    const auto & kcfg = llama_kvswap_cfg::get();
+    if (kcfg.selecting() && n_tps == 1 && swa_type == LLAMA_SWA_TYPE_NONE) {
+        const bool f16 = dst->type == GGML_TYPE_F16;
+        const uint32_t G = kcfg.group;
+        for (int64_t s = 0; s < n_stream; ++s) {
+            const int64_t N = (int64_t) ubatch->pos[s] + 1; // tokens visible to this decode step
+            if (N <= (int64_t) kcfg.window + (int64_t) G*(kcfg.select_m + kcfg.sink_groups)) {
+                continue; // short context: read everything
+            }
+            const int64_t ng = (N + G - 1)/G;
+            std::vector<char> keep_g(ng, 0);
+            for (uint32_t g = 0; g < kcfg.sink_groups && g < ng; ++g) {
+                keep_g[g] = 1;
+            }
+            for (uint32_t k = 0; k < kcfg.select_m; ++k) {
+                keep_g[(int64_t) k*ng/kcfg.select_m] = 1;
+            }
+            const int64_t recent0 = std::max<int64_t>(0, N - (int64_t) kcfg.window);
+            std::vector<std::pair<uint32_t, uint32_t>> ranges;
+            for (int64_t j = 0; j < n_kv; ++j) {
+                const bool keep = j < N && (j >= recent0 || keep_g[j/G]);
+                if (keep) {
+                    if (!ranges.empty() && ranges.back().second == (uint32_t) j) {
+                        ranges.back().second = (uint32_t) j + 1;
+                    } else {
+                        ranges.emplace_back((uint32_t) j, (uint32_t) j + 1);
+                    }
+                }
+                if (!keep) {
+                    if (f16) {
+                        ((ggml_fp16_t *) dst->data)[s*n_kv + j] = llama_cast<ggml_fp16_t>(-INFINITY);
+                    } else {
+                        ((float *) dst->data)[s*n_kv + j] = -INFINITY;
+                    }
+                }
+            }
+            if (s == 0) {
+                kvswap_sel = std::move(ranges);
+            }
+        }
+    }
