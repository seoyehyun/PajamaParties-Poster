+void llama_kv_cache::kvswap_prefetch(int32_t il) const {
+    if (kvswap_sel.empty()) {
+        return;
+    }
+    auto it = map_layer_ids.find(il);
+    if (it == map_layer_ids.end()) {
+        return;
+    }
+    const auto & layer = layers[it->second];
+    for (ggml_tensor * t : { layer.k, layer.v }) {
+        if (!t) {
+            continue;
+        }
+        const size_t row = t->nb[1];
+        for (const auto & r : kvswap_sel) {
+            llama_kvswap_willneed((const char *) t->data + (size_t) r.first*row, (size_t) (r.second - r.first)*row);
+        }
+    }
+}
+
