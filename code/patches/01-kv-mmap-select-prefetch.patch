diff --git a/src/llama-kvswap.h b/src/llama-kvswap.h
new file mode 100644
index 000000000..859e3df74
--- /dev/null
+++ b/src/llama-kvswap.h
@@ -0,0 +1,117 @@
+#pragma once
+
+// KVSwap stage-1 prototype (PajamaParties): file-backed KV cache + fixed cell selection.
+// All knobs are read from environment variables so no public API changes are needed.
+//
+//   LLAMA_KV_OFFLOAD_PATH  file to back the KV cache (mmap, MAP_SHARED). unset = disabled
+//   LLAMA_KV_SELECT        number of groups M to read per decode step (0 = read everything)
+//   LLAMA_KV_GROUP         group size G in cells (default 8)
+//   LLAMA_KV_WINDOW        recent window W in cells, always kept (default 256)
+//   LLAMA_KV_SINK_GROUPS   leading groups always kept (default 4)
+//   LLAMA_KV_PREFETCH      1 = posix_madvise(WILLNEED) next layer's selected ranges
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#if defined(__unix__) || defined(__APPLE__)
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#define LLAMA_KVSWAP_POSIX 1
+#endif
+
+struct llama_kvswap_cfg {
+    std::string path;
+    uint32_t select_m   = 0;
+    uint32_t group      = 8;
+    uint32_t window     = 256;
+    uint32_t sink_groups = 4;
+    bool     prefetch   = false;
+
+    static const llama_kvswap_cfg & get() {
+        static const llama_kvswap_cfg cfg = [] {
+            llama_kvswap_cfg c;
+            auto geti = [](const char * k, uint32_t d) {
+                const char * v = getenv(k);
+                return v ? (uint32_t) strtoul(v, nullptr, 10) : d;
+            };
+            if (const char * p = getenv("LLAMA_KV_OFFLOAD_PATH")) {
+                c.path = p;
+            }
+            c.select_m    = geti("LLAMA_KV_SELECT", 0);
+            c.group       = std::max<uint32_t>(1, geti("LLAMA_KV_GROUP", 8));
+            c.window      = geti("LLAMA_KV_WINDOW", 256);
+            c.sink_groups = geti("LLAMA_KV_SINK_GROUPS", 4);
+            c.prefetch    = geti("LLAMA_KV_PREFETCH", 0) != 0;
+            return c;
+        }();
+        return cfg;
+    }
+
+    bool file_backed() const { return !path.empty(); }
+    bool selecting()   const { return select_m > 0; }
+};
+
+// owns a file mapping; unmaps and closes on destruction
+struct llama_kvswap_map {
+    void * addr = nullptr;
+    size_t size = 0;
+    int    fd   = -1;
+
+    llama_kvswap_map() = default;
+    llama_kvswap_map(const llama_kvswap_map &) = delete;
+    llama_kvswap_map & operator=(const llama_kvswap_map &) = delete;
+
+    bool open(const std::string & path, size_t sz) {
+#ifdef LLAMA_KVSWAP_POSIX
+        fd = ::open(path.c_str(), O_RDWR | O_CREAT, 0644);
+        if (fd < 0) {
+            return false;
+        }
+        // sparse file: unwritten pages read back as zero, so no memset is needed
+        if (ftruncate(fd, (off_t) sz) != 0) {
+            return false;
+        }
+        addr = mmap(nullptr, sz, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (addr == MAP_FAILED) {
+            addr = nullptr;
+            return false;
+        }
+        size = sz;
+        // we control group-wise reads ourselves, so disable kernel readahead
+        posix_madvise(addr, sz, POSIX_MADV_RANDOM);
+        return true;
+#else
+        (void) path; (void) sz;
+        return false;
+#endif
+    }
+
+    ~llama_kvswap_map() {
+#ifdef LLAMA_KVSWAP_POSIX
+        if (addr) {
+            munmap(addr, size);
+        }
+        if (fd >= 0) {
+            ::close(fd);
+        }
+#endif
+    }
+};
+
+// madvise(WILLNEED) over [ptr, ptr+len), rounded out to page boundaries
+inline void llama_kvswap_willneed(const void * ptr, size_t len) {
+#ifdef LLAMA_KVSWAP_POSIX
+    static const uintptr_t pg = (uintptr_t) sysconf(_SC_PAGESIZE);
+    uintptr_t b = (uintptr_t) ptr & ~(pg - 1);
+    uintptr_t e = ((uintptr_t) ptr + len + pg - 1) & ~(pg - 1);
+    posix_madvise((void *) b, e - b, POSIX_MADV_WILLNEED);
+#else
+    (void) ptr; (void) len;
+#endif
+}
