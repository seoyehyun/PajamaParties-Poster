+void llama_kv_cache::kvdio_rows(uint32_t ci, uint32_t a, uint32_t b, size_t & off_k, size_t & len_k, size_t & off_v, size_t & len_v) const {
+    const auto & layer = layers[ci];
+    off_k = (size_t) ((const uint8_t *) layer.k->data - kvdio->base) + (size_t) a*layer.k->nb[1];
+    len_k = (size_t) (b - a)*layer.k->nb[1];
+    off_v = (size_t) ((const uint8_t *) layer.v->data - kvdio->base) + (size_t) a*layer.v->nb[1];
+    len_v = (size_t) (b - a)*layer.v->nb[1];
+}
+
+void llama_kv_cache::kvdio_issue(uint32_t ci) const {
+    size_t ok, lk, ov, lv;
+    for (const auto & r : kvdio_st.load) {
+        kvdio_rows(ci, r.first, r.second, ok, lk, ov, lv);
+        kvdio->submit_read((int) ci, ok, lk);
+        kvdio->submit_read((int) ci, ov, lv);
+    }
+}
+
+void llama_kv_cache::kvdio_begin(uint32_t p0, uint32_t p1, bool decode, uint32_t recent0,
+        std::vector<std::pair<uint32_t, uint32_t>> && load) const {
+    auto & st = kvdio_st;
+    if (st.active) {
+        return; // already begun for this ubatch
+    }
+    st.active = true;
+    st.decode = decode;
+    st.p0     = p0;
+    st.p1     = p1;
+    st.load   = std::move(load);
+    st.issued = 0;
+    st.waited.assign(layers.size(), 0);
+    st.done.assign(layers.size(), 0);
+
+    size_t ok, lk, ov, lv;
+
+    // bring cells [a, b) back into RAM for every layer and wait for them
+    auto readback = [&](uint32_t a, uint32_t b) {
+        for (uint32_t ci = 0; ci < layers.size(); ++ci) {
+            kvdio_rows(ci, a, b, ok, lk, ov, lv);
+            kvdio->submit_read((int) ci, ok, lk);
+            kvdio->submit_read((int) ci, ov, lv);
+        }
+        kvdio->wait_all();
+    };
+
+    if (!decode) {
+        if (kvdio_lo > 0) {
+            // a multi-token ubatch after decoding (e.g. a second prompt) attends to everything: make it all resident again
+            readback(0, kvdio_lo);
+            kvdio_lo = 0;
+        }
+        return;
+    }
+
+    kvdio->steps++;
+
+    if (recent0 < kvdio_lo) {
+        readback(recent0, kvdio_lo); // window moved backwards (cache was edited): the cells are in the file
+        kvdio_lo = recent0;
+    } else if (recent0 > kvdio_lo) {
+        // groups that slid out of the window were flushed when they completed: release their RAM
+        for (uint32_t ci = 0; ci < layers.size(); ++ci) {
+            kvdio_rows(ci, kvdio_lo, recent0, ok, lk, ov, lv);
+            kvdio->evict(ok, lk);
+            kvdio->evict(ov, lv);
+        }
+        kvdio_lo = recent0;
+    }
+
+    // layer 0 is needed right away, the following ones overlap with the computation of the layers before them
+    const uint32_t depth = llama_kvswap_cfg::get().io_depth;
+    while (st.issued <= depth && st.issued < layers.size()) {
+        kvdio_issue(st.issued++);
+    }
+}
+
+void llama_kv_cache::kvswap_dio_wait(int32_t il) const {
+    auto & st = kvdio_st;
+    if (!kvdio || !st.active || !st.decode) {
+        return;
+    }
+    const auto it = map_layer_ids.find(il);
+    if (it == map_layer_ids.end()) {
+        return;
+    }
+    const uint32_t ci = it->second;
+    while (st.issued <= ci) {
+        kvdio_issue(st.issued++);
+    }
+    kvdio->wait((int) ci);
+    st.waited[ci] = 1;
+}
+
+void llama_kv_cache::kvswap_dio_done(int32_t il) const {
+    auto & st = kvdio_st;
+    if (!kvdio || !st.active) {
+        return;
+    }
+    const auto it = map_layer_ids.find(il);
+    if (it == map_layer_ids.end()) {
+        return;
+    }
+    const uint32_t ci = it->second;
+    size_t ok, lk, ov, lv;
+
+    if (st.decode) {
+        if (!st.waited[ci]) {
+            LLAMA_LOG_ERROR("%s: layer %d attention ran without waiting for its KV reads; this model's attention path is not "
+                            "supported in direct-I/O mode\n", __func__, il);
+            abort();
+        }
+        // the cells read for this layer are no longer needed
+        for (const auto & r : st.load) {
+            kvdio_rows(ci, r.first, r.second, ok, lk, ov, lv);
+            kvdio->evict(ok, lk);
+            kvdio->evict(ov, lv);
+        }
+    }
+    st.done[ci] = 1;
+
+    // groups completed by this ubatch go to the file (they stay resident until they leave the window)
+    const uint32_t G = llama_kvswap_cfg::get().group;
+    const uint32_t a = st.p0/G*G;
+    const uint32_t b = st.p1/G*G;
+    if (b > a) {
+        kvdio_rows(ci, a, b, ok, lk, ov, lv);
+        kvdio->write_sync(ok, lk);
+        kvdio->write_sync(ov, lv);
+    }
+
+    if (st.decode) {
+        const uint32_t depth = llama_kvswap_cfg::get().io_depth;
+        while (st.issued < layers.size() && st.issued <= ci + depth + 1) {
+            kvdio_issue(st.issued++);
+        }
+    }
+}
+
+void llama_kv_cache::kvswap_dio_end() const {
+    auto & st = kvdio_st;
+    if (!kvdio || !st.active) {
+        return;
+    }
+    kvdio->wait_all();
+    if (st.decode) {
+        // layers whose attention hook never ran would leak their loaded pages
+        size_t ok, lk, ov, lv;
+        for (uint32_t ci = 0; ci < st.issued && ci < layers.size(); ++ci) {
+            if (!st.done[ci]) {
+                for (const auto & r : st.load) {
+                    kvdio_rows(ci, r.first, r.second, ok, lk, ov, lv);
+                    kvdio->evict(ok, lk);
+                    kvdio->evict(ov, lv);
+                }
+            }
+        }
+        const uint32_t every = llama_kvswap_cfg::get().debug_every;
+        if (every > 0 && kvdio->steps % every == 0) {
+            LLAMA_LOG_INFO("kvswap_dio: step %llu pos=%u lo=%u resident_MiB=%.1f read_MiB=%.1f stall_s=%.3f\n",
+                    (unsigned long long) kvdio->steps, st.p1, kvdio_lo, kvdio->resident_bytes()/1048576.0,
+                    kvdio->bytes_read.load()/1048576.0, kvdio->stall_s);
+        }
+    }
+    st.active = false;
+}
