diff --git a/src/llama-kvswap-io.h b/src/llama-kvswap-io.h
new file mode 100644
index 000000000..651f39f98
--- /dev/null
+++ b/src/llama-kvswap-io.h
@@ -0,0 +1,313 @@
+#pragma once
+
+// KVSwap stage 1b (PajamaParties): explicit direct I/O engine for the KV cache.
+//
+//   anonymous memory  ==  RAM staging area, laid out exactly like the file (file offset == offset inside the mapping)
+//   backing file      ==  the only complete copy of the KV cache; read with O_DIRECT, written with O_DIRECT
+//
+// Cells that leave the resident window are written once to the file and released with MADV_DONTNEED.
+// Before a layer's attention the cells it needs are read back into the *same* addresses, so the unmodified
+// flash-attention kernel (with the stage-1 mask hiding everything else) works on the staging memory.
+// After the attention the pages are released again. Nothing depends on the OS page cache or on a cgroup limit.
+
+#include "llama-kvswap.h"
+#include "llama-impl.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <thread>
+
+#ifdef LLAMA_KVSWAP_POSIX
+#include <cerrno>
+#ifndef MAP_ANONYMOUS
+#define MAP_ANONYMOUS MAP_ANON
+#endif
+#ifdef __APPLE__
+#define MINCORE_VEC_T char
+#else
+#define MINCORE_VEC_T unsigned char
+#endif
+#ifndef MAP_NORESERVE
+#define MAP_NORESERVE 0
+#endif
+#endif
+
+struct llama_kvswap_dio {
+    uint8_t * base  = nullptr;   // anonymous mapping, page aligned
+    size_t    size  = 0;
+    size_t    align = 4096;      // alignment of every file offset / length / buffer address
+    int       fd    = -1;
+    bool      direct = false;    // O_DIRECT (Linux) or F_NOCACHE (macOS) in effect
+
+    // ---- read worker pool -------------------------------------------------------------------------------------
+    struct job { size_t off; size_t len; int ticket; };
+
+    std::vector<std::thread> workers;
+    std::mutex               mu;
+    std::condition_variable  cv_job;
+    std::condition_variable  cv_done;
+    std::deque<job>          q;
+    std::vector<int>         pending;      // outstanding jobs per ticket (= per KV layer)
+    bool                     stop   = false;
+    bool                     failed = false;
+    size_t                   chunk  = 1u << 20;
+
+    // ---- statistics ------------------------------------------------------------------------------------------
+    std::atomic<uint64_t> bytes_read{0};
+    std::atomic<uint64_t> n_reads{0};
+    uint64_t bytes_written = 0;
+    uint64_t n_writes      = 0;
+    uint64_t bytes_evicted = 0;
+    double   stall_s       = 0.0;          // time the compute thread waited for reads
+    double   write_s       = 0.0;
+    uint64_t steps         = 0;
+
+    llama_kvswap_dio() = default;
+    llama_kvswap_dio(const llama_kvswap_dio &) = delete;
+    llama_kvswap_dio & operator=(const llama_kvswap_dio &) = delete;
+
+    static size_t align_up(size_t x, size_t a) { return (x + a - 1) / a * a; }
+
+    bool open(const std::string & path, size_t sz, int n_tickets, uint32_t n_threads, size_t chunk_bytes) {
+#ifdef LLAMA_KVSWAP_POSIX
+        const size_t pg = (size_t) sysconf(_SC_PAGESIZE);
+        align = std::max<size_t>(4096, pg);
+        size  = align_up(sz, align);
+        chunk = std::max<size_t>(align, chunk_bytes / align * align);
+
+        int flags = O_RDWR | O_CREAT | O_TRUNC;
+#ifdef O_DIRECT
+        fd = ::open(path.c_str(), flags | O_DIRECT, 0644);
+        direct = fd >= 0;
+        if (fd < 0 && errno == EINVAL) {
+            LLAMA_LOG_WARN("%s: O_DIRECT not supported on %s, falling back to buffered I/O + fadvise(DONTNEED)\n", __func__, path.c_str());
+        }
+#endif
+        if (fd < 0) {
+            fd = ::open(path.c_str(), flags, 0644);
+#ifdef F_NOCACHE
+            if (fd >= 0 && fcntl(fd, F_NOCACHE, 1) == 0) {
+                direct = true;
+            }
+#endif
+        }
+        if (fd < 0) {
+            LLAMA_LOG_ERROR("%s: cannot open %s: %s\n", __func__, path.c_str(), strerror(errno));
+            return false;
+        }
+        if (ftruncate(fd, (off_t) size) != 0) {
+            LLAMA_LOG_ERROR("%s: ftruncate failed: %s\n", __func__, strerror(errno));
+            return false;
+        }
+        void * m = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+        if (m == MAP_FAILED) {
+            LLAMA_LOG_ERROR("%s: anonymous mmap of %zu bytes failed: %s\n", __func__, size, strerror(errno));
+            return false;
+        }
+        base = (uint8_t *) m;
+#ifdef MADV_NOHUGEPAGE
+        madvise(base, size, MADV_NOHUGEPAGE);   // 2 MiB pages would make partial eviction impossible
+#endif
+        pending.assign(n_tickets, 0);
+        for (uint32_t i = 0; i < n_threads; ++i) {
+            workers.emplace_back([this] { worker(); });
+        }
+        return true;
+#else
+        (void) path; (void) sz; (void) n_tickets; (void) n_threads; (void) chunk_bytes;
+        return false;
+#endif
+    }
+
+    ~llama_kvswap_dio() {
+#ifdef LLAMA_KVSWAP_POSIX
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            stop = true;
+        }
+        cv_job.notify_all();
+        for (auto & t : workers) {
+            t.join();
+        }
+        if (steps > 0) {
+            LLAMA_LOG_INFO("kvswap_dio: steps=%llu read_MiB=%.1f reads=%llu write_MiB=%.1f writes=%llu evict_MiB=%.1f stall_s=%.3f write_s=%.3f resident_MiB=%.1f\n",
+                    (unsigned long long) steps, bytes_read.load()/1048576.0, (unsigned long long) n_reads.load(),
+                    bytes_written/1048576.0, (unsigned long long) n_writes, bytes_evicted/1048576.0,
+                    stall_s, write_s, resident_bytes()/1048576.0);
+        }
+        if (base) {
+            munmap(base, size);
+        }
+        if (fd >= 0) {
+            ::close(fd);
+        }
+#endif
+    }
+
+    // ---- reads ----------------------------------------------------------------------------------------------
+    // queue [off, off+len) of the file to be read into base+off; returns immediately
+    void submit_read(int ticket, size_t off, size_t len) {
+        GGML_ASSERT(off % align == 0 && len % align == 0 && off + len <= size);
+        std::lock_guard<std::mutex> lk(mu);
+        for (size_t o = 0; o < len; o += chunk) {
+            q.push_back({ off + o, std::min(chunk, len - o), ticket });
+            pending[ticket]++;
+        }
+        cv_job.notify_all();
+    }
+
+    // block until every read submitted for this ticket has finished
+    void wait(int ticket) {
+        const auto t0 = std::chrono::steady_clock::now();
+        std::unique_lock<std::mutex> lk(mu);
+        cv_done.wait(lk, [&] { return pending[ticket] == 0; });
+        stall_s += std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+        if (failed) {
+            LLAMA_LOG_ERROR("kvswap_dio: a read from the KV file failed, cannot continue\n");
+            abort();
+        }
+    }
+
+    void wait_all() {
+        for (size_t t = 0; t < pending.size(); ++t) {
+            wait((int) t);
+        }
+    }
+
+    // ---- writes / eviction (called from the compute thread) ---------------------------------------------------
+    void write_sync(size_t off, size_t len) {
+#ifdef LLAMA_KVSWAP_POSIX
+        GGML_ASSERT(off % align == 0 && len % align == 0 && off + len <= size);
+        const auto t0 = std::chrono::steady_clock::now();
+        size_t done = 0;
+        while (done < len) {
+            const ssize_t r = pwrite(fd, base + off + done, len - done, (off_t) (off + done));
+            if (r < 0 && errno == EINTR) {
+                continue;
+            }
+            if (r <= 0) {
+                LLAMA_LOG_ERROR("kvswap_dio: pwrite failed: %s\n", strerror(errno));
+                abort();
+            }
+            done += (size_t) r;
+        }
+        if (!direct) {
+            drop_cache(off, len, /*sync_first=*/true);
+        }
+        bytes_written += len;
+        n_writes++;
+        write_s += std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+#else
+        (void) off; (void) len;
+#endif
+    }
+
+    // give the pages back to the OS; the next touch reads zeros (the file still has the data)
+    void evict(size_t off, size_t len) {
+#ifdef LLAMA_KVSWAP_POSIX
+        GGML_ASSERT(off % align == 0 && len % align == 0 && off + len <= size);
+        if (len == 0) {
+            return;
+        }
+#ifdef __APPLE__
+        // macOS only treats MADV_DONTNEED as a hint and keeps the pages; replacing the mapping really frees them
+        mmap(base + off, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+#else
+        madvise(base + off, len, MADV_DONTNEED);
+#endif
+        bytes_evicted += len;
+#else
+        (void) off; (void) len;
+#endif
+    }
+
+    // bytes of the staging area currently resident in RAM
+    size_t resident_bytes() const {
+#ifdef LLAMA_KVSWAP_POSIX
+        const size_t pg = (size_t) sysconf(_SC_PAGESIZE);
+        std::vector<unsigned char> vec((size_t) 1 << 14);   // 16384 pages per call
+        size_t total = 0;
+        for (size_t o = 0; o < size; o += vec.size() * pg) {
+            const size_t len = std::min(vec.size() * pg, size - o);
+            if (mincore(base + o, len, (MINCORE_VEC_T *) vec.data()) != 0) {
+                return 0;
+            }
+            for (size_t i = 0; i < (len + pg - 1) / pg; ++i) {
+                total += (vec[i] & 1) ? pg : 0;
+            }
+        }
+        return total;
+#else
+        return 0;
+#endif
+    }
+
+private:
+    void drop_cache(size_t off, size_t len, bool sync_first) {
+#ifdef LLAMA_KVSWAP_POSIX
+#if defined(__linux__)
+        if (sync_first) {
+            fdatasync(fd);
+        }
+        posix_fadvise(fd, (off_t) off, (off_t) len, POSIX_FADV_DONTNEED);
+#else
+        (void) off; (void) len; (void) sync_first;
+#endif
+#else
+        (void) off; (void) len; (void) sync_first;
+#endif
+    }
+
+    bool read_full(size_t off, size_t len) {
+#ifdef LLAMA_KVSWAP_POSIX
+        size_t done = 0;
+        while (done < len) {
+            const ssize_t r = pread(fd, base + off + done, len - done, (off_t) (off + done));
+            if (r < 0 && errno == EINTR) {
+                continue;
+            }
+            if (r <= 0) {
+                return false;
+            }
+            done += (size_t) r;
+        }
+        if (!direct) {
+            drop_cache(off, len, /*sync_first=*/false);
+        }
+        bytes_read += len;
+        n_reads++;
+        return true;
+#else
+        (void) off; (void) len;
+        return false;
+#endif
+    }
+
+    void worker() {
+        for (;;) {
+            job j;
+            {
+                std::unique_lock<std::mutex> lk(mu);
+                cv_job.wait(lk, [&] { return stop || !q.empty(); });
+                if (q.empty()) {
+                    return;
+                }
+                j = q.front();
+                q.pop_front();
+            }
+            const bool ok = read_full(j.off, j.len);
+            {
+                std::lock_guard<std::mutex> lk(mu);
+                if (!ok) {
+                    failed = true;
+                }
+                pending[j.ticket]--;
+            }
+            cv_done.notify_all();
+        }
+    }
+};
