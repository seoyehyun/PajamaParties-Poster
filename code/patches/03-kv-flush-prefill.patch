+void llama_kv_cache::kvswap_flush() {
+    if (!kvswap_dirty) {
+        return;
+    }
+    kvswap_dirty = false;
+    const int64_t t_start_us = ggml_time_us();
+    for (const auto & map : kvswap_maps) {
+        if (!map->sync()) {
+            LLAMA_LOG_WARN("%s: msync failed, prefill writeback may overlap decode reads\n", __func__);
+        }
+    }
+    LLAMA_LOG_INFO("%s: flushed prefill writes in %.1f ms\n", __func__, (ggml_time_us() - t_start_us)/1000.0);
+}
