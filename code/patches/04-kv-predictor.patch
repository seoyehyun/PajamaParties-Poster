+                unif += gmass[g];
+            }
+        }
+        auto & a = P.acc[ci];
+        a.base   += base;
+        a.pred   += base + pred;
+        a.oracle += base + oracle;
+        a.unif   += base + unif;
+        a.recall += M ? (double) hit/M : 1.0;
+        a.n++;
+    }
+
+    // 3. normally done already (kvswap_attn_done / kvswap_predict); fallback, e.g. when no prediction arrived
+    if (kvswap_mask && P.mask_ci != (int32_t) ci) {
+        kvswap_mask_apply(P, kvswap_mask, ci);
+    }
+}
