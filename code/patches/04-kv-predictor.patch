+// KVSwap stage 2 helpers ------------------------------------------------------------------------------------------
+
+// row c of a 2-D F16/F32 cache tensor as floats
+static void kvswap_row_f32(const ggml_tensor * t, uint32_t c, float * out) {
+    const char * row = (const char *) t->data + (size_t) c*t->nb[1];
+    if (t->type == GGML_TYPE_F16) {
+        ggml_fp16_to_fp32_row((const ggml_fp16_t *) row, out, t->ne[0]);
+    } else {
+        memcpy(out, row, (size_t) t->ne[0]*sizeof(float));
+    }
+}
+
+// a query node ([hd, n_head, 1] F32) as host floats, head-major. With -ngl the node is computed on the GPU and its
+// data is not host memory, so it is copied out.
+static void kvswap_q_host(const ggml_tensor * q, std::vector<float> & out) {
+    const size_t hd = (size_t) q->ne[0], nh = (size_t) q->ne[1];
+    out.resize(hd*nh);
+    if (q->buffer && !ggml_backend_buffer_is_host(q->buffer)) {
+        if (ggml_is_contiguous(q)) {
+            ggml_backend_tensor_get(q, out.data(), 0, hd*nh*sizeof(float));
+        } else {
+            for (size_t h = 0; h < nh; ++h) {
+                ggml_backend_tensor_get(q, out.data() + h*hd, h*q->nb[1], hd*sizeof(float));
+            }
+        }
+        return;
+    }
+    for (size_t h = 0; h < nh; ++h) {
+        memcpy(out.data() + h*hd, (const char *) q->data + h*q->nb[1], hd*sizeof(float));
+    }
+}
+
+// set mask cells [a, b) of the first row to v (0 or -inf)
+static void kvswap_mask_set(ggml_tensor * m, uint32_t a, uint32_t b, float v) {
+    b = std::min<uint32_t>(b, (uint32_t) m->ne[0]);
+    if (m->type == GGML_TYPE_F16) {
+        const ggml_fp16_t h = ggml_fp32_to_fp16(v);
+        std::fill((ggml_fp16_t *) m->data + a, (ggml_fp16_t *) m->data + b, h);
+    } else {
+        std::fill((float *) m->data + a, (float *) m->data + b, v);
+    }
+}
+
+// put cache layer ci's predicted groups into the shared mask, closing the ones of the layer before
+static void kvswap_mask_apply(llama_kvswap_pred & P, ggml_tensor * mask, uint32_t ci) {
+    for (const auto & rg : P.mask_open) {
+        kvswap_mask_set(mask, rg.first, rg.second, -INFINITY);
+    }
+    P.mask_open.clear();
+    if (P.has_sel[ci]) {
+        for (const auto & rg : P.sel[ci]) {
+            kvswap_mask_set(mask, rg.first, rg.second, 0.0f);
+        }
+        P.mask_open = P.sel[ci];
+    }
+    P.mask_ci = (int32_t) ci;
+}
+
+static inline float kvswap_dot(const float * a, const float * b, uint32_t n) {
+    float s = 0.0f;
+    for (uint32_t i = 0; i < n; ++i) {
+        s += a[i]*b[i];
+    }
+    return s;
+}
+
+void llama_kv_cache::kvswap_predict(int32_t il, const ggml_tensor * q) const {
+    if (!kvpred || !kvswap_sel_now) {
+        return;
+    }
+    const auto it = map_layer_ids.find(il);
+    if (it == map_layer_ids.end()) {
+        return;
+    }
+    const uint32_t ci = it->second;
+    auto & P = *kvpred;
+    if (q->type != GGML_TYPE_F32 || q->ne[2] != 1 || P.klr[ci].empty()) {
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    const auto & kc = llama_kvswap_cfg::get();
+    const uint32_t G  = kc.group;
+    const uint32_t g0 = kc.sink_groups;
+    const uint32_t g1 = kvswap_recent0/G;   // groups entirely before the recent window
+    const uint32_t r  = P.r;
+    (void) r;
+
+    // Q^: sum the query heads that share a KV head, laid out like a K cache row
+    const uint32_t hd = (uint32_t) q->ne[0], n_head = (uint32_t) q->ne[1], n_head_kv = P.d/hd;
+    std::vector<float> qh(P.d, 0.0f), ql(r), qv;
+    kvswap_q_host(q, qv);
+    for (uint32_t h = 0; h < n_head; ++h) {
+        const float * qr = qv.data() + (size_t) h*hd;
+        float * dst = qh.data() + (size_t) (h/(n_head/n_head_kv))*hd;
+        for (uint32_t j = 0; j < hd; ++j) {
+            dst[j] += qr[j];
+        }
+    }
+    P.project(ci, qh.data(), ql.data());
+
+    // group score = max over the group's cells of K_lr . q_lr
+    std::vector<std::pair<float, uint32_t>> cand;
+    cand.reserve(g1 > g0 ? g1 - g0 : 0);
+    if (g1 > g0) {
+        std::vector<float> sc((size_t) (g1 - g0)*G);
+        P.scores(ci, ql.data(), g0*G, g1*G, sc.data());
+        for (uint32_t g = g0; g < g1; ++g) {
+            const float * s = sc.data() + (size_t) (g - g0)*G;
+            cand.emplace_back(*std::max_element(s, s + G), g);
+        }
+    }
+    if (cand.size() > kc.select_m) {
+        std::nth_element(cand.begin(), cand.begin() + kc.select_m, cand.end(),
+                [](const auto & x, const auto & y) { return x.first > y.first; });
+        cand.resize(kc.select_m);
+    }
+    P.sel_groups.clear();
+    for (const auto & c : cand) {
+        P.sel_groups.push_back(c.second);
+    }
+    std::sort(P.sel_groups.begin(), P.sel_groups.end());
+    P.track_reuse(ci, P.sel_groups);
+    auto & ranges = P.sel[ci];
+    ranges.clear();
+    for (uint32_t g : P.sel_groups) {
+        if (!ranges.empty() && ranges.back().second == g*G) {
+            ranges.back().second = (g + 1)*G;
+        } else {
+            ranges.emplace_back(g*G, (g + 1)*G);
+        }
+    }
+    P.has_sel[ci] = 1;
+    if (kvswap_mask && (ci == 0 || P.attn_done[ci - 1])) {
+        kvswap_mask_apply(P, kvswap_mask, ci);   // no-look-ahead layer: the previous attention is already done
+    }
+
+    if (kvdio && kvdio_st.active && kvdio_st.pred) {
+        // direct I/O: read this layer's groups now; with look-ahead this overlaps the previous layer's compute
+        auto & st = kvdio_st;
+        if (st.issued == ci) {
+            auto & L = st.load_l[ci];
+            L = st.load;   // sink groups (sorted, all before g0*G)
+            for (const auto & rg : ranges) {
+                if (!L.empty() && L.back().second == rg.first) {
+                    L.back().second = rg.second;
+                } else {
+                    L.push_back(rg);
+                }
+            }
+            st.load_set[ci] = 1;
+            kvdio_issue(ci);
+            st.issued = ci + 1;
+        }
+    } else if (kc.prefetch && !kvswap_maps.empty()) {
+        const auto & layer = layers[ci];
+        for (const auto & rg : ranges) {
+            llama_kvswap_willneed((const char *) layer.k->data + (size_t) rg.first*layer.k->nb[1], (size_t) (rg.second - rg.first)*layer.k->nb[1]);
+            llama_kvswap_willneed((const char *) layer.v->data + (size_t) rg.first*layer.v->nb[1], (size_t) (rg.second - rg.first)*layer.v->nb[1]);
+        }
+    }
+    P.n_pred++;
+    P.t_pred_s += (ggml_time_us() - t0)*1e-6;
+}
+
+void llama_kv_cache::kvswap_eval_q(int32_t il, const ggml_tensor * q) const {
+    if (!kvpred || !llama_kvswap_cfg::get().pred_eval) {
+        return;
+    }
+    const auto it = map_layer_ids.find(il);
+    if (it != map_layer_ids.end() && q->type == GGML_TYPE_F32 && q->ne[2] == 1) {
+        // the last "Qcur-<il>" before the attention is the roped one; copy it now, the buffer may be reused
+        auto & P = *kvpred;
+        kvswap_q_host(q, P.qx[it->second]);
+        P.qx_hd = (uint32_t) q->ne[0];
+        P.qx_nh = (uint32_t) q->ne[1];
+        P.has_qx[it->second] = 1;
+    }
+}
+
+void llama_kv_cache::kvswap_attn_prep(int32_t il) const {
+    if (!kvpred) {
+        return;
+    }
+    const auto it = map_layer_ids.find(il);
+    if (it == map_layer_ids.end()) {
+        return;
+    }
+    const uint32_t ci = it->second;
+    auto & P = *kvpred;
+    const auto & layer = layers[ci];
+    const auto & kc = llama_kvswap_cfg::get();
+    const uint32_t r = P.r, d = P.d, G = kc.group;
+    const uint32_t kv_size = (uint32_t) layer.k->ne[1];
+
+    // 1. low-rank keys of the cells this ubatch wrote (they are resident right now in every mode)
+    {
+        const int64_t t0 = ggml_time_us();
+        if (P.klr[ci].empty()) {
+            P.kv_size = kv_size;
+            P.klr[ci].assign((size_t) kv_size*r, 0.0f);
+        }
+        std::vector<float> row(d), y(r);
+        for (uint32_t c = kvswap_p0; c < kvswap_p1 && c < kv_size; ++c) {
+            kvswap_row_f32(layer.k, c, row.data());
+            P.project(ci, row.data(), y.data());
+            for (uint32_t j = 0; j < r; ++j) {
+                P.klr[ci][(size_t) j*kv_size + c] = y[j];
+            }
+        }
+        P.t_klr_s += (ggml_time_us() - t0)*1e-6;
+    }
+
+    if (!kvswap_sel_now) {
+        return;
+    }
+
+    // 2. evaluation against the exact attention (needs every old K row in RAM)
+    if (kc.pred_eval && P.has_qx[ci] && !kvdio) {
+        P.has_qx[ci] = 0;
+        const float * qv = P.qx[ci].data();
+        const uint32_t N = kvswap_N, recent0 = kvswap_recent0;
+        const uint32_t hd = P.qx_hd, n_head = P.qx_nh, ratio = n_head/(d/hd);
+        const float scale = 1.0f/sqrtf((float) hd);
+        std::vector<float> logit((size_t) n_head*N), row(d);
+        for (uint32_t c = 0; c < N; ++c) {
+            kvswap_row_f32(layer.k, c, row.data());
+            for (uint32_t h = 0; h < n_head; ++h) {
+                const float * qr = qv + (size_t) h*hd;
+                logit[(size_t) h*N + c] = scale*kvswap_dot(qr, row.data() + (size_t) (h/ratio)*hd, hd);
+            }
+        }
+        std::vector<double> imp(N, 0.0);
+        for (uint32_t h = 0; h < n_head; ++h) {
+            float * l = logit.data() + (size_t) h*N;
+            const float mx = *std::max_element(l, l + N);
+            double sum = 0.0;
+            for (uint32_t c = 0; c < N; ++c) {
+                sum += std::exp((double) (l[c] - mx));
+            }
+            for (uint32_t c = 0; c < N; ++c) {
+                imp[c] += std::exp((double) (l[c] - mx))/sum/n_head;
+            }
+        }
+        const uint32_t g0 = kc.sink_groups, g1 = recent0/G;
+        double base = 0.0;
+        for (uint32_t c = 0; c < N; ++c) {
+            if (c < g0*G || c >= recent0) {
+                base += imp[c];
+            }
+        }
+        std::vector<std::pair<double, uint32_t>> gs;
+        for (uint32_t g = g0; g < g1; ++g) {
+            double m = 0.0;
+            for (uint32_t c = g*G; c < (g + 1)*G; ++c) {
+                m += imp[c];
+            }
+            gs.emplace_back(m, g);
+        }
+        const uint32_t M = std::min<uint32_t>(kc.select_m, (uint32_t) gs.size());
+        std::vector<double> gmass(g1 + 1, 0.0);
+        for (const auto & x : gs) {
+            gmass[x.second] = x.first;
+        }
+        // predicted
+        double pred = 0.0;
+        std::vector<uint8_t> is_pred(g1 + 1, 0);
+        if (P.has_sel[ci]) {
+            for (const auto & rg : P.sel[ci]) {
+                for (uint32_t g = rg.first/G; g < rg.second/G && g < g1; ++g) {
+                    pred += gmass[g];
+                    is_pred[g] = 1;
+                }
+            }
+        }
+        // oracle top-M
+        std::nth_element(gs.begin(), gs.begin() + M, gs.end(), [](const auto & x, const auto & y) { return x.first > y.first; });
+        double oracle = 0.0;
+        uint32_t hit = 0;
+        for (uint32_t k = 0; k < M; ++k) {
+            oracle += gs[k].first;
+            hit += is_pred[gs[k].second];
+        }
+        // stage-1 uniform selection over all groups, only the picks outside sink and window count
+        double unif = 0.0;
+        const uint32_t ng = (N + G - 1)/G;
+        std::vector<uint8_t> is_unif(g1 + 1, 0);
+        for (uint32_t k = 0; k < kc.select_m; ++k) {
+            const uint32_t g = (uint32_t) ((uint64_t) k*ng/kc.select_m);
+            if (g >= g0 && g < g1 && !is_unif[g]) {
