diff --git a/src/llama-kvswap-pred.h b/src/llama-kvswap-pred.h
new file mode 100644
index 0000000..0b1d458
--- /dev/null
+++ b/src/llama-kvswap-pred.h
@@ -0,0 +1,224 @@
+#pragma once
+
+// KVSwap stage 2 (PajamaParties): low-rank key predictor.
+//
+// The adapter A (scripts/make_kvswap_adapter.py) maps a K cache row k (n_embd_k_gqa values) to r values k_lr = A k.
+// K_lr is kept in RAM for every cell. For layer i the graph computes an approximate query q~ from the input of layer i-1
+// (node "kvswap_q-<i>"); the host sums it over the query heads of each KV head (Q^, n_embd_k_gqa values), projects it
+// (q_lr = A Q^) and scores every old cell with K_lr q_lr, which approximates the head-summed attention logit Q^ . k.
+// The top M groups by group-max score are read for layer i, in addition to the sink groups and the recent window.
+//
+//   LLAMA_KV_ADAPTER     GGUF adapter file (tensors "kvswap.A.<il>", ne = [n_embd_k_gqa, r]); with LLAMA_KV_SELECT = M
+//                        it replaces the fixed uniform selection of stage 1 by the prediction
+//   LLAMA_KV_PRED_SAME   1 = predict layer i from its own input (no look-ahead, isolates the low-rank error)
+//   LLAMA_KV_PRED_EXACT  N = layers 0..N-1 use their own input, like the paper does for the first two layers
+//                        (default 2; 1 = look-ahead from layer 1 on). Their reads are not overlapped with compute.
+//   LLAMA_KV_PRED_EVAL   1 = also compute the exact attention of every layer (RAM-resident KV only) and report how much
+//                        attention mass the predicted, the oracle top-M and the stage-1 uniform selections keep
+
+#include "ggml.h"
+#include "gguf.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <utility>
+#include <vector>
+
+struct llama_kvswap_pred {
+    uint32_t r = 0;   // adapter rank
+    uint32_t d = 0;   // n_embd_k_gqa
+
+    std::vector<std::vector<float>> At;    // [cache layer] d*r, transposed adapter: At[i*r + j] = A[j][i]
+    std::vector<std::vector<float>> klr;   // [cache layer] r*kv_size, dimension-major: klr[j*kv_size + c]
+    uint32_t kv_size = 0;
+    std::vector<uint32_t>           il_of; // cache layer -> model layer
+
+    // predicted cell ranges [a, b) of the current decode step, per cache layer (sink and window not included)
+    std::vector<std::vector<std::pair<uint32_t, uint32_t>>> sel;
+    std::vector<uint8_t> has_sel;
+    std::vector<uint32_t> sel_groups;   // scratch
+
+    // ranges the predictor has opened (set to 0) in the shared kq_mask, and whose selection that is
+    std::vector<std::pair<uint32_t, uint32_t>> mask_open;
+    int32_t mask_ci = -1;
+    // attention of a cache layer has finished in the current ubatch. The mask for layer i is written once layer i-1's
+    // attention is done and layer i's selection is known: with -ngl the scheduler copies the mask into the CPU split
+    // when the split starts, so writing it right before the attention (inside the split) would be too late.
+    std::vector<uint8_t> attn_done;
+
+    // exact roped Q per cache layer, copied out for LLAMA_KV_PRED_EVAL ([n_head][hd] floats)
+    std::vector<std::vector<float>> qx;
+    std::vector<uint8_t> has_qx;
+    uint32_t qx_hd = 0, qx_nh = 0;
+
+    // evaluation accumulators, per cache layer
+    struct acc_t {
+        double base = 0, pred = 0, oracle = 0, unif = 0, recall = 0;
+        uint64_t n = 0;
+    };
+    std::vector<acc_t> acc;
+
+    uint64_t n_pred = 0;
+    double   t_pred_s = 0, t_klr_s = 0;
+
+    // reuse between decode steps (always on with the predictor, printed at exit as kvswap_reuse): fraction of this step's groups selected 1 / within 4 / within 16 steps ago
+    std::vector<std::vector<int64_t>> last_step;   // [cache layer][group] last step the group was selected, -1 = never
+    std::vector<int64_t> n_step;                   // [cache layer] decode steps predicted so far
+    struct reuse_t { double h1 = 0, h4 = 0, h16 = 0; uint64_t n = 0; };
+    std::vector<reuse_t> reuse;
+
+    void track_reuse(uint32_t ci, const std::vector<uint32_t> & groups) {
+        if (last_step.empty()) {
+            last_step.resize(il_of.size());
+            n_step.assign(il_of.size(), 0);
+            reuse.resize(il_of.size());
+        }
+        auto & ls = last_step[ci];
+        const int64_t t = n_step[ci]++;
+        uint32_t h1 = 0, h4 = 0, h16 = 0;
+        for (uint32_t g : groups) {
+            if (g >= ls.size()) {
+                ls.resize(g + 1, -1);
+            }
+            const int64_t age = ls[g] < 0 ? INT64_MAX : t - ls[g];
+            h1 += age <= 1; h4 += age <= 4; h16 += age <= 16;
+            ls[g] = t;
+        }
+        if (t > 0 && !groups.empty()) {
+            auto & R = reuse[ci];
+            R.h1 += (double) h1/groups.size(); R.h4 += (double) h4/groups.size(); R.h16 += (double) h16/groups.size();
+            R.n++;
+        }
+    }
+
+    bool load(const std::string & path, const std::vector<uint32_t> & il_of_ci, uint32_t n_embd_k_gqa, std::string & err) {
+        ggml_context * meta = nullptr;
+        gguf_init_params p = { /*.no_alloc =*/ false, /*.ctx =*/ &meta };
+        gguf_context * g = gguf_init_from_file(path.c_str(), p);
+        if (!g) {
+            err = "cannot read " + path;
+            return false;
+        }
+        bool ok = true;
+        d = n_embd_k_gqa;
+        il_of = il_of_ci;
+        At.resize(il_of.size());
+        for (size_t ci = 0; ci < il_of.size() && ok; ++ci) {
+            const std::string name = "kvswap.A." + std::to_string(il_of[ci]);
+            ggml_tensor * t = ggml_get_tensor(meta, name.c_str());
+            if (!t || t->type != GGML_TYPE_F32 || t->ne[0] != (int64_t) d || t->ne[2] != 1) {
+                err = "tensor " + name + " missing, not F32 or not [" + std::to_string(d) + ", r]";
+                ok = false;
+                break;
+            }
+            if (r == 0) {
+                r = (uint32_t) t->ne[1];
+            } else if (t->ne[1] != (int64_t) r) {
+                err = "tensor " + name + " has a different rank";
+                ok = false;
+                break;
+            }
+            const float * a = (const float *) t->data;
+            At[ci].resize((size_t) d*r);
+            for (uint32_t j = 0; j < r; ++j) {
+                for (uint32_t i = 0; i < d; ++i) {
+                    At[ci][(size_t) i*r + j] = a[(size_t) j*d + i];
+                }
+            }
+        }
+        gguf_free(g);
+        ggml_free(meta);
+        if (!ok) {
+            return false;
+        }
+        const size_t n = il_of.size();
+        klr.resize(n);
+        sel.resize(n);
+        has_sel.assign(n, 0);
+        attn_done.assign(n, 0);
+        qx.resize(n);
+        has_qx.assign(n, 0);
+        acc.resize(n);
+        return true;
+    }
+
+    // y[j] = sum_i A[j][i] x[i]; the inner loop runs over j so it vectorizes without reassociating a reduction
+    void project(uint32_t ci, const float * x, float * y) const {
+        const float * at = At[ci].data();
+        for (uint32_t j = 0; j < r; ++j) {
+            y[j] = 0.0f;
+        }
+        for (uint32_t i = 0; i < d; ++i) {
+            const float xi = x[i];
+            const float * row = at + (size_t) i*r;
+            for (uint32_t j = 0; j < r; ++j) {
+                y[j] += row[j]*xi;
+            }
+        }
+    }
+
+    // score[c] = K_lr[c] . q_lr for c in [c0, c1); dimension-major K_lr, inner loop over cells
+    void scores(uint32_t ci, const float * ql, uint32_t c0, uint32_t c1, float * out) const {
+        const uint32_t n = c1 - c0;
+        for (uint32_t c = 0; c < n; ++c) {
+            out[c] = 0.0f;
+        }
+        const float * k = klr[ci].data();
+        for (uint32_t j = 0; j < r; ++j) {
+            const float * kj = k + (size_t) j*kv_size + c0;
+            const float qj = ql[j];
+            for (uint32_t c = 0; c < n; ++c) {
+                out[c] += kj[c]*qj;
+            }
+        }
+    }
+
+    void report() const {
+        uint64_t n_all = 0;
+        acc_t tot;
+        for (const auto & a : acc) {
+            tot.base += a.base; tot.pred += a.pred; tot.oracle += a.oracle; tot.unif += a.unif; tot.recall += a.recall;
+            n_all += a.n;
+        }
+        if (n_pred == 0) {
+            return;   // e.g. a short-lived context that never decoded
+        }
+        fprintf(stderr, "kvswap_pred: rank=%u steps*layers=%llu predict_ms/step=%.3f klr_update_s=%.3f\n", r,
+                (unsigned long long) n_pred, n_pred ? 1e3*t_pred_s/n_pred*il_of.size() : 0.0, t_klr_s);
+        if (!reuse.empty()) {
+            reuse_t T;
+            for (const auto & R : reuse) { T.h1 += R.h1; T.h4 += R.h4; T.h16 += R.h16; T.n += R.n; }
+            if (T.n) {
+                fprintf(stderr, "kvswap_reuse: samples=%llu prev1=%.4f within4=%.4f within16=%.4f\n", (unsigned long long) T.n,
+                        T.h1/T.n, T.h4/T.n, T.h16/T.n);
+                for (size_t ci = 0; ci < reuse.size(); ++ci) {
+                    const auto & R = reuse[ci];
+                    if (R.n) {
+                        fprintf(stderr, "kvswap_reuse: layer %2u prev1=%.4f within4=%.4f within16=%.4f\n", il_of[ci],
+                                R.h1/R.n, R.h4/R.n, R.h16/R.n);
+                    }
+                }
+            }
+        }
+        if (n_all == 0) {
+            return;
+        }
+        // attention mass kept (averaged over heads, layers and steps): sink+window only, + predicted, + oracle, + uniform
+        fprintf(stderr, "kvswap_pred_eval: samples=%llu mass_base=%.4f mass_pred=%.4f mass_oracle=%.4f mass_uniform=%.4f "
+                "group_recall=%.4f\n", (unsigned long long) n_all, tot.base/n_all, tot.pred/n_all, tot.oracle/n_all,
+                tot.unif/n_all, tot.recall/n_all);
+        for (size_t ci = 0; ci < acc.size(); ++ci) {
+            const auto & a = acc[ci];
+            if (a.n) {
+                fprintf(stderr, "kvswap_pred_eval: layer %2u base=%.4f pred=%.4f oracle=%.4f uniform=%.4f recall=%.4f\n",
+                        il_of[ci], a.base/a.n, a.pred/a.n, a.oracle/a.n, a.unif/a.n, a.recall/a.n);
+            }
+        }
+    }
+
+    ~llama_kvswap_pred() {
+        report();
+    }
+};
