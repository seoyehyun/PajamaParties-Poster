+bool llama_kv_cache::kvdio_reuse() const {
+    const auto & kc = llama_kvswap_cfg::get();
+    return kc.reuse > 0 && kc.selecting() && kvdio_st.decode;
+}
+
 void llama_kv_cache::kvdio_issue(uint32_t ci) const {
     size_t ok, lk, ov, lv;
+    if (!kvdio_reuse()) {
+        for (const auto & r : kvdio_load(ci)) {
+            kvdio_rows(ci, r.first, r.second, ok, lk, ov, lv);
+            kvdio->submit_read((int) ci, ok, lk);
+            kvdio->submit_read((int) ci, ov, lv);
