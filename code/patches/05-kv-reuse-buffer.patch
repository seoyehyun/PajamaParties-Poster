+    auto & st = kvdio_st;
+    const uint32_t G  = llama_kvswap_cfg::get().group;
+    const uint32_t gs = llama_kvswap_cfg::get().sink_groups;
+    if (st.rb_used.size() != layers.size()) {
+        st.rb_used.assign(layers.size(), {});
+        st.rb_n.assign(layers.size(), 0);
+    }
+    auto & used = st.rb_used[ci];
+    if (used.size() < (size_t) layers[ci].k->ne[1]/G) {
+        used.resize((size_t) layers[ci].k->ne[1]/G, -1);
+    }
+    const int64_t now = (int64_t) kvdio->steps;
+    uint32_t run0 = 0, run1 = 0;   // pending miss run [run0, run1) in groups
+    auto flush = [&]() {
+        if (run1 > run0) {
+            kvdio_rows(ci, run0*G, run1*G, ok, lk, ov, lv);
+            kvdio->submit_read((int) ci, ok, lk);
+            kvdio->submit_read((int) ci, ov, lv);
+        }
+        run0 = run1 = 0;
+    };
     for (const auto & r : kvdio_load(ci)) {
-        kvdio_rows(ci, r.first, r.second, ok, lk, ov, lv);
-        kvdio->submit_read((int) ci, ok, lk);
-        kvdio->submit_read((int) ci, ov, lv);
+        GGML_ASSERT(r.first % G == 0 && r.second % G == 0);
+        for (uint32_t g = r.first/G; g < r.second/G; ++g) {
+            const bool hit = used[g] >= 0;
+            if (g >= gs) {
+                (hit ? kvdio->reuse_hit : kvdio->reuse_miss)++;
+            }
+            if (hit) {
+                flush();
+            } else {
+                if (g >= gs) {
+                    st.rb_n[ci]++;
+                }
+                if (run1 == g) {
+                    run1 = g + 1;
+                } else {
+                    flush();
+                    run0 = g;
+                    run1 = g + 1;
+                }
+            }
+            used[g] = now;
+        }
+    }
+    flush();
+}
+
+void llama_kv_cache::kvdio_rb_forget(uint32_t g_from) const {
+    auto & st = kvdio_st;
+    const uint32_t gs = llama_kvswap_cfg::get().sink_groups;
+    for (size_t ci = 0; ci < st.rb_used.size(); ++ci) {
+        auto & used = st.rb_used[ci];
+        for (size_t g = g_from; g < used.size(); ++g) {
+            if (used[g] >= 0) {
+                used[g] = -1;
+                if (g >= gs) {
+                    st.rb_n[ci]--;
+                }
+            }
+        }
+    }
+}
+
+void llama_kv_cache::kvdio_rb_trim(uint32_t ci) const {
+    auto & st = kvdio_st;
+    const auto & kc = llama_kvswap_cfg::get();
+    if (ci >= st.rb_used.size() || st.rb_n[ci] <= kc.reuse) {
+        return;
+    }
+    auto & used = st.rb_used[ci];
+    const int64_t now = (int64_t) kvdio->steps;
+    std::vector<std::pair<int64_t, uint32_t>> old;   // (last use, group), groups not used by this step
+    for (uint32_t g = kc.sink_groups; g < used.size(); ++g) {
+        if (used[g] >= 0 && used[g] < now) {
+            old.emplace_back(used[g], g);
+        }
+    }
+    const size_t n_evict = std::min<size_t>(old.size(), st.rb_n[ci] - kc.reuse);
+    std::partial_sort(old.begin(), old.begin() + n_evict, old.end());
+    size_t ok, lk, ov, lv;
+    for (size_t i = 0; i < n_evict; ++i) {
+        const uint32_t g = old[i].second;
+        kvdio_rows(ci, g*kc.group, (g + 1)*kc.group, ok, lk, ov, lv);
+        kvdio->evict(ok, lk);
+        kvdio->evict(ov, lv);
+        used[g] = -1;
+        st.rb_n[ci]--;
     }
 }
 
